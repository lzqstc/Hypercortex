# Server
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
DATA_DIR=./data
MAX_UPLOAD_MB=200
MAX_FILES_PER_JOB=20
INGEST_WORKERS=2

# Chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MIN_CHUNK_CHARS=30
DENSE_TOP_K=30
BM25_TOP_K=30
RERANK_ENABLED=true
RERANK_MODEL=
RERANK_TOP_K=8
MIN_RELEVANCE_SCORE=0.18
MAX_CHUNKS_PER_DOCUMENT=2
MAX_CONTEXT_CHARS=8000

# Embeddings: local | openai | hash
EMBEDDING_PROVIDER=local
# 可填 HuggingFace 模型名，也可填本地目录（离线/内网推荐）：
#   HF_ENDPOINT=https://hf-mirror.com .venv/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download('BAAI/bge-small-zh-v1.5', local_dir='data/models/bge-small-zh-v1.5')"
# 然后设置为 EMBEDDING_MODEL=<项目根>/backend/data/models/bge-small-zh-v1.5
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
# Optional OpenAI-compatible embedding endpoint
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_MODEL=text-embedding-3-small

# Vector store: chroma | sqlite
VECTOR_STORE=chroma

# LLM: none | openai | ollama
# none = extractive answer, still returns citations and sources
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200

# Optional OCR (requires tesseract binary)
OCR_ENABLED=false

# URL ingestion
URL_TIMEOUT_SECONDS=20
ALLOW_PRIVATE_URLS=false

# ---- Wiki / 深度研究 ----
WIKI_ENABLED=true
# 网络检索：auto | duckduckgo | tavily | serpapi | searxng | none
# auto 优先 DuckDuckGo（无需 Key，可能被限流）；生产建议 tavily
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=
SEARXNG_URL=http://127.0.0.1:8080
